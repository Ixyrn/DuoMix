<Window x:Class="DuoMix.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DuoMix" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DuoMix" Width="820" Height="710" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="15" Icon="{DynamicResource DuoMixLogo}">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Border x:Name="Shell" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource Base}"><Grid>
<Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<Grid Background="Transparent"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
<Button Style="{StaticResource CaptionButton}" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M0,6 L12,6" Width="12" Height="12" Stroke="{DynamicResource Text}" StrokeThickness="1"/></Button>
<Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize"><Path x:Name="MaximizeGlyph" Data="M0.5,0.5 L12.5,0.5 L12.5,12.5 L0.5,12.5 Z" Width="13" Height="13" Stroke="{DynamicResource Text}" StrokeThickness="1"/></Button>
<Button Style="{StaticResource CloseCaptionButton}" Click="CloseClick" ToolTip="Close DuoMix" AutomationProperties.Name="Close DuoMix"><Path Data="M0,0 L12,12 M12,0 L0,12" Width="12" Height="12" Stroke="{DynamicResource Text}" StrokeThickness="1"/></Button>
</StackPanel></Grid>
<ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,10,14,0">
<Grid Margin="4,0,4,12"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Image Source="{DynamicResource DuoMixLogo}" Width="52" Height="52"/><StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="BrandTitle" Text="DuoMix" FontFamily="pack://application:,,,/Assets/Fonts/#Rajdhani" FontSize="36" FontWeight="Bold" FontStyle="Italic" Padding="0,0,8,0"/></StackPanel><Button Grid.Column="2" FontSize="20" Padding="9" VerticalAlignment="Top" Margin="0,6,0,0" Click="SettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Button></Grid>
<Border Style="{StaticResource CardStyle}"><StackPanel><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Device settings" Foreground="{DynamicResource LinkText}" Background="Transparent" BorderThickness="0" Padding="0" Click="DeviceSettingsClick"/><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/><TextBlock Text="MICROPHONE" Style="{StaticResource Heading}"/></StackPanel></DockPanel><ComboBox x:Name="MicPicker" Margin="0,0,0,10" SelectionChanged="MicChanged" AutomationProperties.Name="Microphone"/><local:SourceStrip x:Name="MicStrip"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel><Grid MinHeight="36" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/><TextBlock Text="PROGRAMS" Style="{StaticResource Heading}"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="＋  Add Program" Style="{StaticResource Primary}" Click="AddProgramClick" Margin="12,0,12,0"/><Button Content="⟳  Refresh" Click="RefreshClick"/></StackPanel></Grid><TextBlock x:Name="EmptyPrograms" Text="No programs added yet. Choose an app to bring its audio into the mix." Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,18"/><StackPanel x:Name="ProgramRows"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel><DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" CornerRadius="18" Background="#1432D791" BorderBrush="#245F50" BorderThickness="1" Padding="15,7" VerticalAlignment="Top"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#2AE3A4" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="ReadyLabel" Text="Ready" Foreground="#2AE3A4" VerticalAlignment="Center"/></StackPanel></Border><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/><TextBlock Text="GAME MICROPHONE" Style="{StaticResource Heading}"/></StackPanel></StackPanel></DockPanel>
<Border CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Field}" Padding="12,10" Margin="0,0,0,10"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Connection" Click="RouteClick" Margin="0,0,8,0"/><Button Content="✎  Rename" Click="RenameClick"/></StackPanel><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Muted}" Margin="0,0,24,0" VerticalAlignment="Center"/><StackPanel><TextBlock TextTrimming="CharacterEllipsis" x:Name="CableName" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Select this input in your game." Style="{StaticResource Small}" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Button x:Name="MixButton" Content="▶  Start Mixing" Style="{StaticResource Primary}" FontSize="15" FontWeight="SemiBold" Click="MixClick" Margin="0,0,12,0"/><Grid Grid.Column="1" Margin="0,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions><TextBlock Text="Output" VerticalAlignment="Center"/><Slider x:Name="MasterGain" Grid.Column="1" Value="100" ValueChanged="MasterChanged" Margin="8,0,15,0"/><Border Grid.Column="2" Background="{DynamicResource Field}" CornerRadius="7" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="7,9"><TextBlock x:Name="MasterValue" Text="100%" TextAlignment="Center"/></Border></Grid><local:LevelMeter x:Name="OutputMeter" Grid.Column="2"/></Grid></StackPanel></Border>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel VerticalAlignment="Center"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="v1.0.1" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="GitHubLink" Style="{StaticResource FooterLinkButton}" Width="28" Height="26" Click="GitHubClick" ToolTip="DuoMix on GitHub" AutomationProperties.Name="DuoMix on GitHub"><Viewbox Width="17" Height="17"><Path Fill="{DynamicResource Muted}" Data="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/></Viewbox></Button><Button x:Name="KoFiLink" Style="{StaticResource FooterLinkButton}" Width="28" Height="26" Margin="3,0,0,0" Click="KoFiClick" ToolTip="Support Ixyrn on Ko-fi" AutomationProperties.Name="Support Ixyrn on Ko-fi"><Viewbox Width="19" Height="17"><Path Fill="{DynamicResource Muted}" Data="M11.351 2.715c-2.7 0-4.986.025-6.83.26C2.078 3.285 0 5.154 0 8.61c0 3.506.182 6.13 1.585 8.493 1.584 2.701 4.233 4.182 7.662 4.182h.83c4.209 0 6.494-2.234 7.637-4a9.5 9.5 0 0 0 1.091-2.338C21.792 14.688 24 12.22 24 9.208v-.415c0-3.247-2.13-5.507-5.792-5.87-1.558-.156-2.65-.208-6.857-.208m0 1.947c4.208 0 5.09.052 6.571.182 2.624.311 4.13 1.584 4.13 4v.39c0 2.156-1.792 3.844-3.87 3.844h-.935l-.156.649c-.208 1.013-.597 1.818-1.039 2.546-.909 1.428-2.545 3.064-5.922 3.064h-.805c-2.571 0-4.831-.883-6.078-3.195-1.09-2-1.298-4.155-1.298-7.506 0-2.181.857-3.402 3.012-3.714 1.533-.233 3.559-.26 6.39-.26m6.547 2.287c-.416 0-.65.234-.65.546v2.935c0 .311.234.545.65.545 1.324 0 2.051-.754 2.051-2s-.727-2.026-2.052-2.026m-10.39.182c-1.818 0-3.013 1.48-3.013 3.142 0 1.533.858 2.857 1.949 3.897.727.701 1.87 1.429 2.649 1.896a1.47 1.47 0 0 0 1.507 0c.78-.467 1.922-1.195 2.623-1.896 1.117-1.039 1.974-2.364 1.974-3.897 0-1.662-1.247-3.142-3.039-3.142-1.065 0-1.792.545-2.338 1.298-.493-.753-1.246-1.298-2.312-1.298"/></Viewbox></Button></StackPanel><TextBlock x:Name="StatusDot" Text="●" Foreground="#28D893" Margin="0,0,12,0"/><TextBlock x:Name="Status" Text="Monitoring sources • game microphone is off" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
<Grid x:Name="Overlay" Grid.RowSpan="3" Background="#99040912" Visibility="Collapsed"><Border x:Name="Dialog" TextElement.Foreground="{DynamicResource Text}" Width="480" MaxHeight="610" Padding="22" CornerRadius="18" Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><DockPanel Margin="0,0,0,20"><Button Content="✕" DockPanel.Dock="Right" Click="DismissClick" Padding="10,5"/><TextBlock x:Name="DialogTitle" Text="Settings" FontSize="21" FontWeight="SemiBold"/></DockPanel><StackPanel x:Name="SettingsPanel"><TextBlock Text="APPEARANCE" Style="{StaticResource Heading}" Margin="0,0,0,12"/><TextBlock Text="Color theme" Margin="0,0,0,8"/><ComboBox x:Name="ThemePicker" SelectionChanged="AppearanceChanged" Margin="0,0,0,20"/><TextBlock Text="Window material" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><RadioButton x:Name="SolidMaterial" Content="Solid Color" GroupName="Material" Checked="MaterialChanged" Margin="0,0,24,0"/><RadioButton x:Name="GlassMaterial" Content="Liquid Glass" GroupName="Material" Checked="MaterialChanged"/></StackPanel><TextBlock Text="Glass tint strength"/><Slider x:Name="TintSlider" Minimum="0" Maximum="100" Value="25" ValueChanged="TintChanged" Margin="0,10,0,0"/><TextBlock x:Name="GlassHint" Text="Blur the desktop behind the window while keeping controls sharp." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,6,0,12"/><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><TextBlock Text="Your theme, material, volume, and microphone preferences are saved automatically." TextWrapping="Wrap" Style="{StaticResource Small}"/></Border><TextBlock x:Name="DriverInfo" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,10,0,0"><TextBlock Text="DuoMix by Ixyrn" HorizontalAlignment="Right" Style="{StaticResource Small}" FontSize="12"/></Border></StackPanel><StackPanel x:Name="RoutingPanel" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><RadioButton x:Name="RouteAuto" Content="Automatic" GroupName="Route" Checked="RouteModeChanged" Margin="0,0,20,0"/><RadioButton x:Name="RouteManual" Content="Choose endpoints" GroupName="Route" Checked="RouteModeChanged"/></StackPanel><TextBlock Text="Send mix to (cable playback endpoint)" Margin="0,4,0,6"/><ComboBox x:Name="RouteRender"/><TextBlock Text="Use in game (matching recording endpoint)" Margin="0,12,0,6"/><ComboBox x:Name="RouteCapture"/><TextBlock Text="Choose both ends of the same virtual cable. For VB-CABLE: CABLE Input → CABLE Output. Speakers and physical microphones do not form a virtual cable. Stop mixing to change this connection." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,10"/><TextBlock x:Name="RouteError" TextWrapping="Wrap" Foreground="#DB536C"/><Button Content="Save connection" Style="{StaticResource Primary}" Click="SaveRouteClick" Margin="0,8"/><TextBlock Text="Optional: VB-CABLE by VB-Audio is donationware. All participations are welcome. Install only if you need a virtual cable." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,6"/><StackPanel Orientation="Horizontal"><Button Content="Install VB-CABLE" Click="InstallCableClick" Margin="0,0,8,0"/><Button Content="VB-Audio website / donate" Click="CableWebsiteClick"/></StackPanel></StackPanel><StackPanel x:Name="RenamePanel" Visibility="Collapsed"><TextBlock Text="Game microphone name" Margin="0,0,0,8"/><TextBox x:Name="DeviceNameInput" MaxLength="64" KeyDown="RenameKeyDown" AutomationProperties.Name="Device name"/><TextBlock Text="This changes the recording-device name in Windows. Games may append the driver name or need their device list refreshed." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,12"/><TextBlock x:Name="RenameError" Foreground="#FF7187" TextWrapping="Wrap" Margin="0,0,0,10"/><Button x:Name="RenameSave" Content="Save device name" Style="{StaticResource Primary}" Click="SaveRenameClick"/></StackPanel><StackPanel x:Name="PickerPanel" Visibility="Collapsed"><TextBox x:Name="AppSearch" TextChanged="SearchChanged" AutomationProperties.Name="Search programs"/><TextBlock Text="Running programs • select an app, then Add" Style="{StaticResource Small}" Margin="0,12"/><ListBox x:Name="AppList" Height="210" MouseDoubleClick="AppDoubleClick"/><Button Content="Add selected program" Style="{StaticResource Primary}" Click="ConfirmAddClick" Margin="0,18,0,0"/></StackPanel></StackPanel></ScrollViewer></Border></Grid>
</Grid></Border></Window>




